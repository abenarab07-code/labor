fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../nitro/dist/cli/index.mjs" "$@"
elif [ -x "$basedir/node" ]; then
